{
  "$defs": {
    "AgentInfo": {
      "description": "The agent (tool, model, session) behind a record.",
      "properties": {
        "model": {
          "description": "The model id, when the source knows it.",
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "description": "The agent session id, used to group work and to match captures.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "The agent tool, e.g. `claude-code`.",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "type": "object"
    },
    "Alternative": {
      "description": "An option the agent considered and rejected.",
      "properties": {
        "option": {
          "type": "string"
        },
        "rejected_because": {
          "type": "string"
        }
      },
      "required": [
        "option",
        "rejected_because"
      ],
      "type": "object"
    },
    "BlobId": {
      "description": "Full git object id (SHA-1 or SHA-256), lowercase hex.",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "CaptureId": {
      "description": "ULID: 26 Crockford base32 characters, time-ordered.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "Change": {
      "description": "The changes a record made to one file.",
      "properties": {
        "after_blob": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Blob of the file right after the change; absent when the change deleted the file."
        },
        "hunks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Hunk"
          },
          "type": "array"
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "CommitId": {
      "description": "Full git object id (SHA-1 or SHA-256), lowercase hex.",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "DecisionId": {
      "description": "ULID: 26 Crockford base32 characters, time-ordered.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "Hunk": {
      "description": "One changed region of a file, with unified-diff (`git diff -U0`) semantics.\n\n`old_*` refers to the file before the change, `new_*` to the file after it. Lines are\n1-based. A pure insertion has `old_lines == 0` and `old_start` is the line it was\ninserted after; a pure deletion has `new_lines == 0` and `new_start` is the line after\nwhich the removed lines used to be. Either start may be `0` for a change at the very\ntop of the file.",
      "properties": {
        "new_lines": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "new_start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "old_lines": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "old_start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "old_start",
        "old_lines",
        "new_start",
        "new_lines"
      ],
      "type": "object"
    },
    "RepoPath": {
      "description": "Path relative to the repository root, '/' separated, no '..' segments.",
      "minLength": 1,
      "type": "string"
    },
    "Source": {
      "description": "Who produced a record.",
      "oneOf": [
        {
          "const": "agent",
          "description": "An AI agent, typically through the MCP `record_decision` tool.",
          "type": "string"
        },
        {
          "const": "hook",
          "description": "An editor hook; carries hunks but no reasoning.",
          "type": "string"
        },
        {
          "const": "human",
          "description": "A person, through the CLI or the app.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A decision: what an agent or person changed, and why. Immutable once written.",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required unless `source` is `human`."
    },
    "allowed_by": {
      "description": "The rule that allowed the action. Free text until the rules engine exists.",
      "type": "string"
    },
    "alternatives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "type": "array"
    },
    "base_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitId"
        },
        {
          "type": "null"
        }
      ],
      "description": "HEAD when the change was made; absent in a repository with no commits."
    },
    "captures": {
      "default": [],
      "description": "Hook captures this decision explains (ADR 0007).",
      "items": {
        "$ref": "#/$defs/CaptureId"
      },
      "type": "array"
    },
    "changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Change"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/DecisionId"
    },
    "reasoning": {
      "default": "",
      "description": "Why the change was made. May be empty only for `source: hook`.",
      "type": "string"
    },
    "schema": {
      "description": "Schema version; always [`SCHEMA_VERSION`] for records this build writes.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "task": {
      "description": "The prompt or task summary.",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "timestamp",
    "source",
    "task",
    "allowed_by"
  ],
  "title": "Decision",
  "type": "object"
}
